{
  "name": "co-breathing-visual",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "package:handoff": "npm run build && node scripts/package-handoff.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:benchmark": "EXHIBITION_PREVIEW=1 EXHIBITION_BENCHMARK=1 playwright test e2e/exhibition-benchmark.spec.ts --project=chromium-1080p --workers=1",
    "test:media": "EXHIBITION_MEDIA=1 playwright test e2e/exhibition-media.spec.ts --project=chromium-1080p --workers=1"
  },
  "dependencies": {
    "three": "0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/three": "0.185.1",
    "typescript": "7.0.2",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
